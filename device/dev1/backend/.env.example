# dev1 nfc-player backend config — copy to backend/.env on the Pi and fill in.
# NEVER commit the real .env (it holds live Spotify creds).

# Spotify app used by app.py for playback control + token refresh.
# app.py refreshes via PKCE (client_id only, NO client secret needed).
SPOTIFY_CLIENT_ID=
SPOTIFY_REFRESH_TOKEN=
# Optional: a bootstrap access token; app.py prefers a fresh PKCE refresh.
SPOTIFY_ACCESS_TOKEN=

# Eddi backend that resolves new-format eddi.audio/c/{id} cards.
# Defaults (in app.py) to the prod API Gateway if unset.
EDDI_API_BASE=https://4p46ddsze9.execute-api.us-east-1.amazonaws.com/prod
